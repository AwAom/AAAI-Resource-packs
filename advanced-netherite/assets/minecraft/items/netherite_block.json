{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "netherite_iron_block",
        "model": {
          "type": "minecraft:model",
          "model": "advancednetherite:block/netherite_iron_block"
        }
      },
      {
        "when": "netherite_gold_block",
        "model": {
          "type": "minecraft:model",
          "model": "advancednetherite:block/netherite_gold_block"
        }
      },
      {
        "when": "netherite_emerald_block",
        "model": {
          "type": "minecraft:model",
          "model": "advancednetherite:block/netherite_emerald_block"
        }
      },
      {
        "when": "netherite_diamond_block",
        "model": {
          "type": "minecraft:model",
          "model": "advancednetherite:block/netherite_diamond_block"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:block/netherite_block"
    }
  }
}