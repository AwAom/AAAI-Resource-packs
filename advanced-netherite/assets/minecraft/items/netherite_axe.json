          "model": "advancednetherite:item/netherite_gold_axe"
        }
      },
      {
        "when": "netherite_emerald_axe",
        "model": {
          "type": "minecraft:model",
          "model": "advancednetherite:item/netherite_emerald_axe"
        }
      },
      {
        "when": "netherite_diamond_axe",
        "model": {
          "type": "minecraft:model",
          "model": "advancednetherite:item/netherite_diamond_axe"
        }
      },
      {
        "when": "netherite_warden_axe",
